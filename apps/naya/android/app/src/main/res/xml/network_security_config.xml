<?xml version="1.0" encoding="utf-8"?>
<!-- Gömülü 3D viewer cihazın kendi içindeki bir HTTP sunucusundan yüklenir
     (127.0.0.1). Android 9'dan beri şifresiz HTTP varsayılan olarak kapalı;
     yalnız bu adres için açıyoruz, dış adresler HTTPS kalır. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
