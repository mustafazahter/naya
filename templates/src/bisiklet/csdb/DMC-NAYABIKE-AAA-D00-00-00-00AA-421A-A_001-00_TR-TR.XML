    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYABIKE-D00-001"/>
        <faultDescr><descr>Sürüşte gıcırtı, tıkırtı ya da vuruntu sesi geliyor.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Bisikleti sehpaya alın ve pedalı çevirmeden yalnız arka tekerleği döndürün.</action>
              <isolationStepQuestion>Ses yalnız pedal çevirince mi geliyor?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0002"/><noAnswer nextActionRefId="stp-0003"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Ayakta pedal basarken ve otururken sesi dinleyin; sonra pedal kollarını yanlara itin.</action>
              <isolationStepQuestion>Ses ayakta ve her pedal turunda aynı noktada mı geliyor?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-crank"/><noAnswer nextActionRefId="end-chain"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Ön freni sıkıp bisikleti ileri geri itin ve bisikleti tümseklerde zıplatın.</action>
              <isolationStepQuestion>Ses önden, furç ya da çataldan mı geliyor?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-fork"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Sele üzerinde otururken ağırlığınızı kaydırın.</action>
              <isolationStepQuestion>Ses seleden ya da sele borusundan mı geliyor?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-seat"/><noAnswer nextActionRefId="end-wheel"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-crank"><action>Pedal, pedal kolu ve orta göbeği kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYABIKE" systemDiffCode="AAA" systemCode="DA1" subSystemCode="2" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-chain"><action>Zinciri temizleyip yağlayın; ses sürerse vites ayarını kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYABIKE" systemDiffCode="AAA" systemCode="DA1" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="241" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-fork"><action>Çatalı ve furçu kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYABIKE" systemDiffCode="AAA" systemCode="DA0" subSystemCode="2" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-seat"><action>Sele borusunu söküp temizleyin ve gresleyin; sele kelepçesini sıkın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYABIKE" systemDiffCode="AAA" systemCode="DA0" subSystemCode="4" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="241" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-wheel"><action>Tekerlekleri, telleri ve çabuk sökme mandallarını kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYABIKE" systemDiffCode="AAA" systemCode="DA3" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
          </isolationMainProcedure>
          <closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
        </isolationProcedure>
