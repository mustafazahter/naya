              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-qr"/><noAnswer nextActionRefId="end-hub"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0006">
              <action>Tekerleği çevirip janta bakın.</action>
