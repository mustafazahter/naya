              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0005"/><noAnswer nextActionRefId="stp-0006"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Çabuk sökme mandalının kapalı ve sıkı olduğunu kontrol edin.</action>
