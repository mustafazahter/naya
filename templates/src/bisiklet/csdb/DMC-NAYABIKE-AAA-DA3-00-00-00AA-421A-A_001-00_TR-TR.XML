              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-valve"/><noAnswer nextActionRefId="stp-0003"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>İç lastiği çıkarıp deliğin yerine bakın.</action>
              <isolationStepQuestion>Delik iç lastiğin jant tarafında mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-rim-tape"/><noAnswer nextActionRefId="end-tube"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
