      <mainProcedure>
        <proceduralStep><title>Her sürüşten önce</title><proceduralStep><para>Sürüş öncesi kontrolü yapın.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Her sürüşten sonra</title><proceduralStep><para>Çamurlu sürüşten sonra bisikleti yıkayın, zinciri kurulayıp yağlayın.</para></proceduralStep><proceduralStep><para>Çatal iç borularını ve toz keçelerini temiz bir bezle silin.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Her 25 saatte ya da ayda bir</title><proceduralStep><para>Zinciri temizleyip yağlayın.</para></proceduralStep><proceduralStep><para>Fren balatası kalınlığını ve kol boşluğunu kontrol edin.</para></proceduralStep><proceduralStep><para>Tekerleklerde yalpa ve tel gevşekliği olup olmadığına bakın.</para></proceduralStep><proceduralStep><para>Vites ayarını kontrol edin.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Her 50 saatte ya da üç ayda bir</title><proceduralStep><para>Zincir aşınmasını ölçün.</para></proceduralStep><proceduralStep><para>Çatal alt bacak yağını değiştirin ve toz keçelerini temizleyin.</para></proceduralStep><proceduralStep><para>Cıvataları sıkma torklarına göre kontrol edin.</para></proceduralStep><proceduralStep><para>Fren ve vites tellerini ve kılıflarını kontrol edin.</para></proceduralStep><proceduralStep><para>Fren disklerinin kalınlığını ölçün.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Her 100 saatte ya da yılda bir</title><proceduralStep><para>Fren ve vites tellerini ve kılıflarını değiştirin.</para></proceduralStep><proceduralStep><para>Furç, göbek ve pedal rulmanlarının boşluğunu ve dönüşünü kontrol edin; gerekiyorsa bakımını yapın.</para></proceduralStep><proceduralStep><para>Orta göbeği kontrol edin.</para></proceduralStep><proceduralStep><para>Sele borusunu söküp temizleyin ve gresleyin.</para></proceduralStep><proceduralStep><para>Çatalın yetkili serviste tam bakımını yaptırın.</para></proceduralStep></proceduralStep>
      </mainProcedure>
