              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-belt"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Depodaki yağa bakın.</action>
