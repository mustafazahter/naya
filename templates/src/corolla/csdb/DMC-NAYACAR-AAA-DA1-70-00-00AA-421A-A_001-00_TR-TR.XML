              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-filter"/><noAnswer nextActionRefId="end-regulator"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Motoru durdurun ve 5 dakika sonra basınca bakın.</action>
              <isolationStepQuestion>Basınç 147 kPa'nın altına düştü mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-leak"/><noAnswer nextActionRefId="end-injectors"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-fuse"><action>Sigortayı ya da röleyi değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA6" subSystemCode="6" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
