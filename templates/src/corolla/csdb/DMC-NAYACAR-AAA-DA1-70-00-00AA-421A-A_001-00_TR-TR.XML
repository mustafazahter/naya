          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Kontağı açarken arka koltuğun altını dinleyin.</action>
              <isolationStepQuestion>Pompa 2 saniye kadar vızıldıyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0003"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>EFI sigortasını ve devre açma rölesini kontrol edin.</action>
              <isolationStepQuestion>Sigorta ya da röle arızalı mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-fuse"/><noAnswer nextActionRefId="end-pump"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Yakıt basıncını ölçün.</action>
              <isolationStepQuestion>Basınç 304 kPa'nın altında mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0004"/><noAnswer nextActionRefId="stp-0005"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
