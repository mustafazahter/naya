    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYACAR-DA0-001"/>
        <faultDescr><descr>Silecekler çalışmıyor, yerine dönmüyor ya da cam suyu fışkırmıyor.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Kontağı açın ve sileceği her kademede çalıştırın.</action>
              <isolationStepQuestion>Silecekler hiç hareket etmiyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0002"/><noAnswer nextActionRefId="stp-0003"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Sigorta kutusunda WIPER sigortasını kontrol edin.</action>
              <isolationStepQuestion>Sigorta atmış mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-fuse"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Sileceği kapatın.</action>
              <isolationStepQuestion>Kollar camın altındaki yerlerine dönmeden duruyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-motor"/><noAnswer nextActionRefId="stp-0005"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Silecek motorunun soketinde kontak açıkken ve düğme açıkken 12 V olup olmadığını ölçün.</action>
              <isolationStepQuestion>Gerilim var mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-motor"/><noAnswer nextActionRefId="end-switch"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Cam suyu düğmesine basın ve depoyu dinleyin.</action>
              <isolationStepQuestion>Pompanın vızıltısı geliyor ama su gelmiyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-nozzle"/><noAnswer nextActionRefId="end-washer"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-fuse"><action>Sigortayı değiştirin; yeniden atarsa kısa devreyi arayın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA6" subSystemCode="6" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-motor"><action>Silecek motoru ya da içindeki park anahtarı arızalı; motoru değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA0" subSystemCode="4" subSubSystemCode="0" assyCode="00" disassyCode="01" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-switch"><action>Motora gerilim gelmiyor: silecek kolu anahtarı ya da kablo arızalı; yetkili servise başvurun.</action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-nozzle"><action>Depo dolu ise memeler ya da hortum tıkalı; memeleri iğneyle açın, hortumu kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA0" subSystemCode="4" subSubSystemCode="0" assyCode="00" disassyCode="02" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-washer"><action>Cam suyu pompası çalışmıyor; pompayı kontrol edip değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA0" subSystemCode="4" subSubSystemCode="0" assyCode="00" disassyCode="02" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
          </isolationMainProcedure>
