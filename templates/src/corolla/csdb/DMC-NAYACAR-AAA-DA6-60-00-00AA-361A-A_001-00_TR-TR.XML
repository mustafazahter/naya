    <procedure>
      <preliminaryRqmts>
        <reqCondGroup><reqCondNoRef><reqCond>Akü dolu; bütün kapılar, bagaj ve kaput kapalı (kaput müşiri varsa basılı).</reqCond></reqCondNoRef></reqCondGroup>
        <reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="tl-0001"><name>Multimetre</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-075</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr><supportEquipDescr id="tl-0002"><name>Lokma takımı</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-002</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips>
