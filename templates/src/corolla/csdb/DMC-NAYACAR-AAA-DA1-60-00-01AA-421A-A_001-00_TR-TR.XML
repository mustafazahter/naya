            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Gaz kelebeği gövdesinin içine bakın.</action>
              <isolationStepQuestion>Kelebek kenarında kalın karbon birikintisi var mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-throttle"/><noAnswer nextActionRefId="end-iscv"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-cable"><action>Gaz telini ayarlayın ya da değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA1" subSystemCode="6" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="271" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
