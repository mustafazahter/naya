    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYACAR-DA2-001"/>
        <faultDescr><descr>Vites zor geçiyor, debriyaj kaçırıyor ya da kalkışta araç sarsılıyor.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Düz yolda üçüncü viteste gaza basın.</action>
              <isolationStepQuestion>Devir yükseliyor ama araç hızlanmıyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-clutch"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Motor çalışırken debriyaja tam basıp birinci vitese takın.</action>
              <isolationStepQuestion>Vites dişli sesiyle mi giriyor?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0003"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Debriyaj hidroliği deposunun seviyesini kontrol edin.</action>
              <isolationStepQuestion>Seviye düşük mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-hydraulic"/><noAnswer nextActionRefId="stp-0005"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Şanzıman yağı seviyesini kontrol edin.</action>
              <isolationStepQuestion>Seviye düşük mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-oil"/><noAnswer nextActionRefId="stp-0006"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Debriyaj pedalının serbest boşluğunu ölçün.</action>
              <isolationStepQuestion>Pedal 5-15 mm boşluktan sonra direnç göstermiyor ya da yavaşça yere iniyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-hydraulic"/><noAnswer nextActionRefId="end-clutch"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0006">
              <action>Vites kolunu boşta sağa sola oynatın.</action>
              <isolationStepQuestion>Kolda fazla boşluk var ya da vitesler belirsiz mi?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-linkage"/><noAnswer nextActionRefId="end-shop"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-clutch"><action>Debriyaj balatası aşınmış ya da baskı zayıf; debriyaj setini değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA2" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-hydraulic"><action>Hidrolik kaçağını bulun, hidroliği tamamlayın ve havasını alın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA2" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="271" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-oil"><action>Şanzıman yağını tamamlayın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA2" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-linkage"><action>Vites kolu burçlarını ve kumanda tellerini kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYACAR" systemDiffCode="AAA" systemCode="DA2" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="01" disassyCodeVariant="AA" infoCode="271" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-shop"><action>Senkromeç aşınmış olabilir; yetkili servise başvurun.</action></isolationProcedureEnd>
