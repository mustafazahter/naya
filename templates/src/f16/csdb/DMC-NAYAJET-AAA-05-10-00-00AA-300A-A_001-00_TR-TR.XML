  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup><reqCondNoRef><reqCond>Uçak takozlu ve topraklı; iniş takımı emniyet pimleri ve fırlatma koltuğu emniyet pimleri takılı.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Motor durdurulmuş, ana şalter kapalı.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Elektrik gücü kesik; ilgili devre kesiciler açık ve etiketli.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Hidrolik sistemlerde basınç yok.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Uçak hangarda; erişim panelleri muayene planına göre açılmış.</reqCond></reqCondNoRef></reqCondGroup>
        <reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="tl-0001"><name>El feneri</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-007</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr><supportEquipDescr id="tl-0002"><name>Ayna</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-009</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr><supportEquipDescr id="tl-0003"><name>Boroskop</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-008</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips>
        <reqSupplies><noSupplies/></reqSupplies>
        <reqSpares><noSpares/></reqSpares>
        <reqSafety><safetyRqmts><warning><warningAndCautionPara>Motor durduktan sonra lüle, art yakıcı ve frenler uzun süre sıcak kalır; soğumasını bekleyin.</warningAndCautionPara></warning></safetyRqmts></reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep><para>Muayene aralığını ve ek işleri uçağın bakım programından alın; önceki muayenede açık kalan kayıtları gözden geçirin.</para><figure id="fig-0001"><title>Uçak, soldan görünüş</title><graphic infoEntityIdent="ICN-NAYAJET-AAA-D000000-0-NAYA0-00001-A-001-01"/></figure></proceduralStep>
        <proceduralStep><title>Gövde ve kanatlar</title><proceduralStep><para>Gövde, kanat, kuyruk ve konformal tank yüzeylerini çatlak, ezik, korozyon ve gevşek bağlantı elemanı açısından muayene edin.</para></proceduralStep><proceduralStep><para>Radomu, hava alığını ve iniş takımı kapaklarını muayene edin.</para></proceduralStep><proceduralStep><para>Statik boşaltıcıları ve anten tabanlarını kontrol edin.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Sistemler</title><proceduralStep><para>Uçuş kumanda yüzeylerinin menteşe ve eyleyici bağlantılarını muayene edin.</para></proceduralStep><proceduralStep><para>Hidrolik ve yakıt hatlarını, bağlantı noktalarını ve pompaları sızıntı ve sürtünme açısından kontrol edin.</para></proceduralStep><proceduralStep><para>Kablo demetlerini, konnektörleri ve topraklama şeritlerini kontrol edin.</para></proceduralStep><proceduralStep><para>Oksijen, klima ve hava alma kanallarını muayene edin.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>İniş takımı</title><proceduralStep><para>Dikmeleri, tork kollarını, açma-kapama eyleyicilerini ve kilitleri muayene edin.</para></proceduralStep><proceduralStep><para>Tekerlekleri, lastikleri ve frenleri muayene edin.</para></proceduralStep></proceduralStep>
        <proceduralStep><title>Motor</title><proceduralStep><para>Fanı, kompresör girişini ve lüleyi muayene edin.</para></proceduralStep><proceduralStep><para>Yağ filtresini ve talaş algılayıcıyı kontrol edin; yağ örneği alın.</para></proceduralStep><proceduralStep><para>Bakım programı gerektiriyorsa boroskop muayenesi yapın.</para></proceduralStep></proceduralStep>
        <proceduralStep><para>Bulunan her eksikliği kayda geçirin, giderilmesini izleyin ve panelleri kapatmadan önce alet sayımı yapın.</para></proceduralStep>
      </mainProcedure>
      <closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
