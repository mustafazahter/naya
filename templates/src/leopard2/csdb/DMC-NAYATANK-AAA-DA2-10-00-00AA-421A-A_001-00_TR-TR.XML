            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Sürüş kumandalarını ve vites seçiciyi kontrol edin.</action>
              <isolationStepQuestion>Kumanda bağlantısı gevşek ya da sıkışık mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-controls"/><noAnswer nextActionRefId="end-service"/></yesNoAnswer></isolationStepAnswer>
