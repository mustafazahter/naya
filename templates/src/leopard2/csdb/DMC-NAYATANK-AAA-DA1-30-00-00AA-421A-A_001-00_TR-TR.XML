    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYATANK-DA1-002"/>
        <faultDescr><descr>Motor sıcaklık göstergesi yükseliyor ya da hararet uyarısı yanıyor.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Motoru rölantiye alın, tankı durdurup motoru soğumaya bırakın. Motor güvertesi ızgaralarına bakın.</action>
              <isolationStepQuestion>Izgaralar yaprak ya da çamurla tıkalı mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-grille"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Motor soğuduktan sonra soğutma sıvısı seviyesini kontrol edin.</action>
              <isolationStepQuestion>Seviye düşük mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0004"/><noAnswer nextActionRefId="stp-0003"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Motoru çalıştırın ve fanların döndüğünü ızgaralardan dinleyin ve hava akışını hissedin.</action>
              <isolationStepQuestion>İki fan da dönüyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0005"/><noAnswer nextActionRefId="end-fan"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Soğutma hortumlarına ve kelepçelerine bakın.</action>
              <isolationStepQuestion>Hortumda ıslaklık, beyaz kalıntı ya da çatlak var mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-hose"/><noAnswer nextActionRefId="end-coolant"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Soğutma sıvısının rengine ve bakım kaydındaki değişim tarihine bakın.</action>
              <isolationStepQuestion>Sıvı bulanık, paslı ya da değişimi gecikmiş mi?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-coolant-change"/><noAnswer nextActionRefId="end-radiator"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-grille"><action>Izgaraları temizleyin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA0" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="250" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-coolant"><action>Soğutma sıvısını tamamlayın ve sızıntıyı arayın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-hose"><action>Sızdıran hortumu ya da kelepçeyi değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-coolant-change"><action>Soğutma sıvısını değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="220" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-radiator"><action>Fanlar çalışıyor: radyatör petekleri kirli olabilir; temizleyin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="250" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-fan"><action>Fan dönmüyor: fanları ve fan tahrikini muayene edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="3" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="310" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
          </isolationMainProcedure>
