      <mainProcedure>
        <proceduralStep><para>Boşaltma tapasının altına yağ toplama kabını yerleştirin.</para><figure id="fig-0002"><title>Güç paketi</title><graphic infoEntityIdent="ICN-NAYATANK-AAA-D000000-0-NAYA0-00002-A-001-01"/></figure></proceduralStep>
