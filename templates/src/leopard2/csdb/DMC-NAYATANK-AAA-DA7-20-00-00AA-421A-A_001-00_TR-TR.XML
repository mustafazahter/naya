  <content>
    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYATANK-DA7-002"/>
        <faultDescr><descr>Gösterge panelinde yangın söndürme sistemi arıza uyarısı yanıyor ya da el tipi söndürücünün göstergesi düşük; yangın belirtisi yok.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Önce gerçek bir yangın belirtisi (duman, koku, ısı) olup olmadığını kontrol edin.</action>
              <isolationStepQuestion>Yangın belirtisi var mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-fire"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>El tipi söndürücülerin göstergelerine ve mühürlerine bakın.</action>
              <isolationStepQuestion>Bir söndürücünün göstergesi düşük ya da mührü kopuk mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-extinguisher"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Söndürücü tüplerinin göstergelerine bakın.</action>
              <isolationStepQuestion>Bir tüpün göstergesi düşük mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-bottle"/><noAnswer nextActionRefId="stp-0003"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Algılayıcıların ve kablolarının üstüne bakın.</action>
              <isolationStepQuestion>Algılayıcı kirli ya da kablosu hasarlı mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-detector"/><noAnswer nextActionRefId="end-service"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-fire"><action>Motoru durdurun, mürettebatı tahliye edin ve el kitabındaki yangın talimatını uygulayın.</action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-extinguisher"><action>Söndürücüyü yenisiyle değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA7" subSystemCode="2" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-bottle"><action>Tüpü yetkili bakım birimine değiştirtin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA7" subSystemCode="2" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="310" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-detector"><action>Algılayıcıyı silin, kablo hasarını bildirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA7" subSystemCode="2" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="310" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-service"><action>Kontrol ünitesi arızalı olabilir; yetkili bakım birimine bildirin.</action></isolationProcedureEnd>
          </isolationMainProcedure>
          <closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
        </isolationProcedure>
      </faultIsolationProcedure>
    </faultIsolation>
