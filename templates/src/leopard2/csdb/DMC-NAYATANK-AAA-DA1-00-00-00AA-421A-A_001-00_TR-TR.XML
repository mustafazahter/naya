    <faultIsolation>
      <faultIsolationProcedure>
        <fault faultCode="NAYATANK-DA1-001"/>
        <faultDescr><descr>Motor çalışmıyor: marş dönmüyor ya da marş dönüyor ama motor ateş almıyor.</descr></faultDescr>
        <isolationProcedure>
          <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqSupportEquips><noSupportEquips/></reqSupportEquips><reqSupplies><noSupplies/></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><noSafety/></reqSafety></preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-0001">
              <action>Ana şalteri açın ve marşa basın.</action>
              <isolationStepQuestion>Marş motoru dönüyor mu?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0003"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0002">
              <action>Akü gerilimini göstergeden ya da voltmetreyle kontrol edin.</action>
              <isolationStepQuestion>Gerilim düşük mü?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-battery"/><noAnswer nextActionRefId="end-starter"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0003">
              <action>Yakıt göstergesini ve yakıt kesme valfinin konumunu kontrol edin.</action>
              <isolationStepQuestion>Tankta yakıt var ve valf açık mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0004"/><noAnswer nextActionRefId="end-fuel"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0004">
              <action>Yakıt filtresinin su ayırıcısında su ya da tortu olup olmadığına bakın.</action>
              <isolationStepQuestion>Filtrede su ya da tortu var mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-filter"/><noAnswer nextActionRefId="stp-0005"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-0005">
              <action>Hava filtresi tıkanıklık göstergesine bakın.</action>
              <isolationStepQuestion>Gösterge kırmızı mı?</isolationStepQuestion>
              <isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-air"/><noAnswer nextActionRefId="end-service"/></yesNoAnswer></isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="end-battery"><action>Aküleri şarj edin ya da değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA4" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-starter"><action>Aküler dolu ama marş dönmüyor: marş motoru, rölesi ya da kabloları arızalı olabilir; yetkili bakım birimine bildirin.</action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-fuel"><action>Yakıt ikmali yapın ya da kesme valfini açın. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="5" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="210" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-filter"><action>Yakıt filtresindeki suyu boşaltın ve filtreyi kontrol edin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="5" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="300" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-air"><action>Hava filtresi elemanlarını değiştirin. <dmRef><dmRefIdent><dmCode modelIdentCode="NAYATANK" systemDiffCode="AAA" systemCode="DA1" subSystemCode="4" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="AA" infoCode="920" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></action></isolationProcedureEnd>
            <isolationProcedureEnd id="end-service"><action>Yakıt, hava ve elektrik normal: enjeksiyon sistemi ya da motor kontrol ünitesi arızalı olabilir; yetkili bakım birimine bildirin.</action></isolationProcedureEnd>
          </isolationMainProcedure>
          <closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
