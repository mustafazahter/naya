    <procedure>
      <preliminaryRqmts>
        <reqCondGroup><reqCondNoRef><reqCond>Tank düz zeminde, motor durdurulmuş, park freni çekili.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Ana şalter açık; motor durdurulmuş.</reqCond></reqCondNoRef><reqCondNoRef><reqCond>Ölçü ve ayar değerleri bu şablonda verilmez; aracın kendi teknik el kitabındaki değerleri kullanın.</reqCond></reqCondNoRef></reqCondGroup>
        <reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="tl-0001"><name>Multimetre</name><identNumber><manufacturerCode>NAYA0</manufacturerCode><partAndSerialNumber><partNumber>NC-TL-034</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips>
