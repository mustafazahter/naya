{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hotspots.schema.json",
  "title": "Etiket noktaları (map/hotspots.json)",
  "type": "object",
  "required": ["hotspots"],
  "properties": {
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "part", "position"],
        "properties": {
          "id": { "type": "string" },
          "part": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "label": { "type": "string" }
        }
      }
    }
  }
}
