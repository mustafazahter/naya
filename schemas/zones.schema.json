{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zones.schema.json",
  "title": "Bölgeler (map/zones.json)",
  "type": "object",
  "required": ["zones"],
  "properties": {
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^z\\." },
          "name": { "type": "string", "minLength": 1 },
          "parent": { "type": "string" }
        }
      }
    }
  }
}
